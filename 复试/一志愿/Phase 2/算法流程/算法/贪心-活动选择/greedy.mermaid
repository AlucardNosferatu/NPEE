flowchart TD
    %% 开始虚拟节点
    Start([开始])
    
    %% INIT动作
    Start --> INIT
    
    %% 状态和动作流程
    INIT --> n_eq_0{"INIT 分支"}
    n_eq_0 -- n==0 --> FINAL_STATE
    n_eq_0 -- n>0 --> STATE_0
    
    STATE_0[STATE_0: 验证非空活动列表初始化状态]
    STATE_0 -- SORT_ACTIVITIES --> STATE_1
    
    STATE_1[STATE_1: 验证活动排序后的状态]
    STATE_1 -- SELECT_FIRST_ACTIVITY --> STATE_2
    
    STATE_2[STATE_2: 验证第一个活动选择后的状态]
    STATE_2 -- CHECK_NEXT_ACTIVITY --> check_branch{"CHECK_NEXT_ACTIVITY 分支"}
    
    check_branch -- i<n且兼容 --> STATE_3
    check_branch -- i<n且不兼容 --> STATE_4
    check_branch -- i>=n --> FINAL_STATE
    
    STATE_3[STATE_3: 验证当前活动兼容状态]
    STATE_3 -- SELECT_COMPATIBLE_ACTIVITY --> STATE_5
    
    STATE_4[STATE_4: 验证当前活动不兼容状态]
    STATE_4 -- SKIP_INCOMPATIBLE_ACTIVITY --> STATE_6
    
    STATE_5[STATE_5: 验证选择兼容活动后的状态]
    STATE_5 -- CHECK_NEXT_ACTIVITY --> check_branch
    
    STATE_6[STATE_6: 验证跳过不兼容活动后的状态]
    STATE_6 -- CHECK_NEXT_ACTIVITY --> check_branch
    
    FINAL_STATE[FINAL_STATE: 最终状态验证]
    
    %% 注释说明
    %% 所有动作标签都放在箭头上，不在节点中
    %% 分支节点处理动作的条件跳转
    %% 状态节点在矩形框中