graph TD
    %% 快速排序：对输入vector<int>排序，返回升序序列
    %% 输入参数：待排序的整数序列
    %% 输出参数：排序后的升序序列
    %% 核心思想：通过分区操作将序列分为小于基准和大于基准的两部分，递归处理子序列
    %% 虚拟入口节点
    Start[开始] -->|INIT| STATE_0[STATE_0：初始参数断言]
    
    %% 初始流程
    STATE_0 -->|PUSH_INITIAL_PROBLEM| STATE_1[STATE_1：初始问题入栈后断言]
    
    %% CHECK_STACK分支（栈检查）
    STATE_1 -->|CHECK_STACK| CHECK_STACK_Branch{CHECK_STACK 分支}
    
    %% CHECK_STACK分支处理
    CHECK_STACK_Branch -->|栈空| FINAL_STATE[FINAL_STATE：最终状态断言]
    CHECK_STACK_Branch -->|栈非空| STATE_2[STATE_2：栈弹出后状态断言]
    
    %% 栈非空处理流程
    STATE_2 -->|CHECK_BASE_CASE| CHECK_BASE_CASE_Branch{CHECK_BASE_CASE 分支}
    
    %% CHECK_BASE_CASE分支处理
    CHECK_BASE_CASE_Branch -->|基础情况| CHECK_STACK_Branch
    CHECK_BASE_CASE_Branch -->|需要分区| STATE_3[STATE_3：基准选择后状态断言]
    
    %% 分区初始化流程
    STATE_3 -->|INIT_PARTITION| STATE_4[STATE_4：分区初始化后断言]
    
    %% 分区循环开始
    STATE_4 -->|PARTITION_LOOP_START| PARTITION_LOOP_START_Branch{PARTITION_LOOP_START 分支}
    
    %% 分区循环分支处理
    PARTITION_LOOP_START_Branch -->|继续遍历| STATE_5[STATE_5：分区循环中状态断言]
    PARTITION_LOOP_START_Branch -->|遍历完成| STATE_6[STATE_6：分区完成后状态断言]
    
    %% 分区循环内部流程
    STATE_5 -->|PARTITION_COMPARE| PARTITION_LOOP_START_Branch
    
    %% 分区完成后的处理
    STATE_6 -->|DIVIDE_SORT| STATE_7[STATE_7：子问题划分后断言]
    
    %% 回到栈检查，形成主循环
    STATE_7 -->|CHECK_STACK| CHECK_STACK_Branch
    
    %% 最终状态（流程图终点）
    %% 注意：RETURN_RESULT动作标签不在流程图中体现