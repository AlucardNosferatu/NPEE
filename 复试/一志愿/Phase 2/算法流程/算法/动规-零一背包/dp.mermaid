graph TD
    %% 0-1背包问题：动态规划解法
    %% 输入参数：capacity - 背包容量，weights - 物品重量数组，values - 物品价值数组
    %% 输出参数：能够装入背包的最大总价值
    %% 核心思想：使用动态规划，dp[j]表示容量为j的背包能装下的最大价值
    %% 虚拟入口节点
    Start[开始] -->|INIT| STATE_0[STATE_0：初始参数断言]
    
    %% CHECK_ITEMS_LOOP分支（物品循环检查）
    STATE_0 -->|CHECK_ITEMS_LOOP| CHECK_ITEMS_LOOP_Branch{CHECK_ITEMS_LOOP 分支}
    
    %% CHECK_ITEMS_LOOP分支处理
    CHECK_ITEMS_LOOP_Branch -->|i<n| STATE_1[STATE_1：获取物品信息后断言]
    CHECK_ITEMS_LOOP_Branch -->|i≥n| FINAL_STATE_NODE[FINAL_STATE：最终状态断言]
    
    %% 物品处理流程
    STATE_1 -->|INIT_CAPACITY_LOOP| STATE_2[STATE_2：容量循环初始化后断言]
    
    %% CHECK_CAPACITY_LOOP分支（容量循环检查）
    STATE_2 -->|CHECK_CAPACITY_LOOP| CHECK_CAPACITY_LOOP_Branch{CHECK_CAPACITY_LOOP 分支}
    
    %% CHECK_CAPACITY_LOOP分支处理
    CHECK_CAPACITY_LOOP_Branch -->|j≥0| CHECK_ITEM_FIT_Branch{CHECK_ITEM_FIT 分支}
    CHECK_CAPACITY_LOOP_Branch -->|j<0| STATE_5[STATE_5：递增物品索引后断言]
    
    %% CHECK_ITEM_FIT分支处理（物品能否放入）
    CHECK_ITEM_FIT_Branch -->|j≥weight_i| STATE_3[STATE_3：更新DP值后断言]
    CHECK_ITEM_FIT_Branch -->|j<weight_i| STATE_4[STATE_4：递减容量索引后断言]
    
    %% 容量循环内部流程
    STATE_3 -->|DECREMENT_CAPACITY| STATE_4
    STATE_4 -->|CHECK_CAPACITY_LOOP| CHECK_CAPACITY_LOOP_Branch
    
    %% 外层循环返回
    STATE_5 -->|INCREMENT_ITEM_INDEX| CHECK_ITEMS_LOOP_Branch
    
    %% 最终状态（流程图终点）
    %% 注意：RETURN_RESULT动作标签不在流程图中体现