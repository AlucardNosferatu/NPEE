Cell[BoxData[
 RowBox[{"DSolve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"y", "'''"}], "[", "x", "]"}], "-", 
     RowBox[{
      RowBox[{"y", "''"}], "[", "x", "]"}]}], "==", 
    RowBox[{"3", "*", 
     RowBox[{
      RowBox[{"(", "x", ")"}], "^", "2"}]}]}], ",", 
   RowBox[{"y", "[", "x", "]"}], ",", "x"}], "]"}]], "Input",
 CellChangeTimes->{{3.920190199384224*^9, 3.920190235930216*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"17f51a02-98d4-c74b-bf13-03bd250eff29"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"y", "[", "x", "]"}], "\[Rule]", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "3"}], " ", 
      SuperscriptBox["x", "2"]}], "-", 
     SuperscriptBox["x", "3"], "-", 
     FractionBox[
      SuperscriptBox["x", "4"], "4"], "+", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", "x"], " ", 
      TemplateBox[{"1"},
       "C"]}], "+", 
     TemplateBox[{"2"},
      "C"], "+", 
     RowBox[{"x", " ", 
      TemplateBox[{"3"},
       "C"]}]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.920190236955244*^9},
 CellLabel->"Out[3]=",ExpressionUUID->"3f5041ac-5127-3c44-8a72-87a0eccdf90e"]
}, Open  ]],

