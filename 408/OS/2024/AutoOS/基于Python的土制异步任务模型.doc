: py; gutter: true; theme: Confluence; collapse: true" data-theme=3D"Conflu=
ence">if __name__ =3D=3D '__main__':
    ret =3D []
    flag =3D []
    pause =3D [False]
    fb_thread =3D Thread(target=3Dexec_task, args=3D({'var1': 1, 'var2': 2,=
 'var3': 3, 'ret': ret}, task_a, flag, pause))
    fb_thread.start()
    while len(flag) &lt;=3D 0 or not flag[0]:
        time.sleep(0.1)
        pause[0] =3D True
        time.sleep(2)
        print('=E8=BF=94=E5=9B=9E=E5=80=BC:{}'.format(ret))
        pause[0] =3D False</pre>=20
