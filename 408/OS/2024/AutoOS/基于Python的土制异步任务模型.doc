<div class=3D"codeContent panelContent pdl hide-toolbar">=20
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: py; gutter: true; theme: Confluence; collapse: true" data-theme=3D"Conflu=
ence">def exec_task(params, func, flag, _pause):
    _ =3D params
    flag.clear()
    lines =3D list(inspect.getsourcelines(func)[0])
    lines.pop(0)
    args =3D inspect.getfullargspec(func)
    keys =3D args.args
    for key in keys:
        exec("{}=3Dparams['{}']".format(key, key))
    while len(lines) &gt; 0:
        do_exec =3D True
        line =3D lines.pop(0).strip()
        if line.startswith('#'):
            line =3D line[1:].strip()
            # print('=E6=9D=A1=E4=BB=B6:{}'.format(line))
            do_exec =3D eval(line)
            line =3D lines.pop(0).strip()
        wait =3D False
        while _pause[0]:
            if not wait:
                print('pause')
                wait =3D True
        if wait:
            print('resume')
        if do_exec:
            exec(line)
        time.sleep(0.01)
    flag.append(True)</pre>=20
