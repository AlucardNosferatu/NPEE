# ==============================================
# Bochs 软盘主扇区（MBR）调试配置（x86专用）
# 功能：加载你的练习代码作为软盘主扇区，启用图形化调试器
# ==============================================

# 1. 内存配置（实模式足够用，不用改）
megs: 32  # 分配32MB内存，远超实模式需求

# 2. BIOS配置（用Bochs内置BIOS，不用额外下载）
romimage: file=$BXSHARE/BIOS-bochs-latest  # 系统BIOS（自动定位安装目录）
vgaromimage: file=$BXSHARE/VGABIOS-lgpl-latest.bin  # 显卡BIOS（支持显示输出）

ata0: enabled=1, ioaddr1=0x1f0, ioaddr2=0x3f0, irq=14
ata0-master: type=disk, path="C:\WWIII\mbr_lk.img", mode=flat

# 4. 启动顺序（从软盘启动，对应主扇区引导）
boot: c

# 5. 调试器配置（强制启用图形调试面板，不用额外设置）
debug: action=ignore, pci=ignore  # 开启调试模式
debugger_log: bochs_debug.log  # 调试日志（可选，出错时查看）
magic_break:enabled=1

# 6. 显示配置（适配调试时的显示输出）
display_library: win32,options="gui_debug"  # 图形显示库（默认，支持调试面板悬浮）
vga: extension=vbe, update_freq=30  # 基础VGA支持，不影响调试