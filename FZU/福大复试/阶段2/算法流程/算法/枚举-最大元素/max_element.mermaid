graph TD
    %% 暴力枚举查找数组元素最大值：遍历数组找到最大元素值
    %% 输入参数：整数数组（vector<int>）
    %% 输出参数：数组中的最大值（int类型）
    %% 核心思想：遍历数组每个元素，记录当前遇到的最大值
    %% 虚拟入口节点
    Start[开始] -->|INIT| STATE_0[STATE_0：初始参数断言]
    
    %% CHECK_ARRAY_EMPTY分支（数组空检查）
    STATE_0 -->|CHECK_ARRAY_EMPTY| CHECK_ARRAY_EMPTY_Branch{CHECK_ARRAY_EMPTY 分支}
    
    %% CHECK_ARRAY_EMPTY分支处理
    CHECK_ARRAY_EMPTY_Branch -->|数组为空| FINAL_STATE_NODE[FINAL_STATE：最终状态断言]
    CHECK_ARRAY_EMPTY_Branch -->|数组非空| STATE_1[STATE_1：循环条件更新后断言]
    
    %% 主循环开始
    STATE_1 -->|CHECK_LOOP_CONTINUE| CHECK_LOOP_CONTINUE_Branch{CHECK_LOOP_CONTINUE 分支}
    
    %% CHECK_LOOP_CONTINUE分支处理
    CHECK_LOOP_CONTINUE_Branch -->|循环继续| STATE_2[STATE_2：获取元素后断言]
    CHECK_LOOP_CONTINUE_Branch -->|循环停止| FINAL_STATE_NODE
    
    %% 元素处理流程
    STATE_2 -->|COMPARE_WITH_MAX| STATE_3[STATE_3：比较更新后断言]
    STATE_3 -->|INCREMENT_INDEX| STATE_4[STATE_4：索引递增后断言]
    
    %% 循环返回
    STATE_4 -->|UPDATE_LOOP_CONDITION| STATE_1
    
    %% 最终状态（流程图终点）
    %% 注意：RETURN_RESULT动作标签不在流程图中体现