graph TD
    %% 基于回溯的二叉树前序遍历：根->左->右
    %% 输入参数：root - 二叉树根节点
    %% 输出参数：前序遍历结果序列
    %% 核心思想：使用自定义栈模拟递归，回溯访问右子树
    %% 虚拟入口节点
    Start[开始] -->|INIT| STATE_0[STATE_0：初始参数断言]
    
    %% CHECK_ROOT_NULL分支（根节点检查）
    STATE_0 -->|CHECK_ROOT_NULL| CHECK_ROOT_NULL{CHECK_ROOT_NULL 分支}
    
    %% CHECK_ROOT_NULL分支处理
    CHECK_ROOT_NULL -->|CHECK_ROOT_NULL| FINAL_STATE[FINAL_STATE：最终状态断言]
    CHECK_ROOT_NULL -->|CHECK_ROOT_NULL| STATE_7[STATE_7：存在节点待处理状态断言]

    STATE_7 -->|PROCESS_CURRENT_NODE| STATE_1[STATE_1：节点检查完成后状态]

    %% 左子树检查流程
    STATE_1 -->|CHECK_LEFT_CHILD| CHECK_LEFT_CHILD{CHECK_LEFT_CHILD 分支}
    
    %% CHECK_LEFT_CHILD分支处理
    CHECK_LEFT_CHILD -->|CHECK_LEFT_CHILD→PUSH_CURRENT_TO_STACK| STATE_2[STATE_2：压栈后状态断言]
    CHECK_LEFT_CHILD -->|CHECK_LEFT_CHILD→CHECK_RIGHT_CHILD| CHECK_RIGHT_CHILD{CHECK_RIGHT_CHILD 分支}
    
    %% 左子树遍历流程
    STATE_2 -->|MOVE_TO_LEFT_CHILD| STATE_3[STATE_3：移动到左子节点后断言]
    STATE_3 -->|PROCESS_CURRENT_NODE| STATE_1[STATE_1：节点检查完成后状态]
    
    %% CHECK_RIGHT_CHILD分支处理
    CHECK_RIGHT_CHILD -->|CHECK_RIGHT_CHILD→MOVE_TO_RIGHT_CHILD| STATE_4[STATE_4：移动到右子节点后断言]
    CHECK_RIGHT_CHILD -->|CHECK_RIGHT_CHILD→SET_BACKTRACK_FLAG| STATE_5[STATE_5：设置回溯标志后断言]
    
    %% 右子树遍历流程
    STATE_4 -->|PROCESS_CURRENT_NODE| STATE_1[STATE_1：节点检查完成后状态]
    
    %% 回溯流程
    STATE_5 -->|CHECK_BACKTRACK_CONDITION| CHECK_BACKTRACK_CONDITION{CHECK_BACKTRACK_CONDITION 分支}
    
    %% CHECK_BACKTRACK_CONDITION分支处理
    STATE_6 -->|CHECK_RIGHT_CHILD| CHECK_RIGHT_CHILD{CHECK_RIGHT_CHILD 分支}
    
    %% CHECK_BACKTRACK_CONDITION分支处理（三种情况）
    CHECK_BACKTRACK_CONDITION -->|CHECK_BACKTRACK_CONDITION| STATE_8[STATE_8：栈非空需要回溯]
    CHECK_BACKTRACK_CONDITION -->|CHECK_BACKTRACK_CONDITION| FINAL_STATE
    CHECK_BACKTRACK_CONDITION -->|CHECK_BACKTRACK_CONDITION| STATE_9[STATE_9：不需要回溯]
    
    STATE_8 -->|POP_FROM_STACK| STATE_6
    STATE_9 -->|PROCESS_CURRENT_NODE| STATE_1

