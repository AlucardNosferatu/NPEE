graph TD
    %% 虚拟入口节点
    Start[开始] -->|INIT| STATE_0[STATE_0：初始参数断言]
    
    %% CHECK_REMAINING分支（剩余猴子检查）
    STATE_0 -->|CHECK_REMAINING| CHECK_REMAINING_Branch{CHECK_REMAINING 分支}
    
    %% CHECK_REMAINING分支处理
    CHECK_REMAINING_Branch -->|remaining==1| STATE_4[STATE_4：开始查找后状态断言]
    CHECK_REMAINING_Branch -->|remaining>1| CHECK_CURRENT_MONKEY_Branch{CHECK_CURRENT_MONKEY 分支}
    
    %% 查找最终猴子流程
    STATE_4 -->|CHECK_SEARCH_LOOP| CHECK_SEARCH_LOOP_Branch{CHECK_SEARCH_LOOP 分支}
    
    %% CHECK_SEARCH_LOOP分支处理
    CHECK_SEARCH_LOOP_Branch -->|next_index<n| STATE_5[STATE_5：检查猴子状态后断言]
    CHECK_SEARCH_LOOP_Branch -->|next_index≥n| FINAL_STATE_NODE[FINAL_STATE：最终状态断言]
    
    %% 查找循环
    STATE_5 -->|CHECK_MONKEY_STATUS| CHECK_SEARCH_LOOP_Branch
    
    %% 主循环：检查当前猴子状态
    CHECK_CURRENT_MONKEY_Branch -->|在圈内| PROCESS_COUNTING_Branch{PROCESS_COUNTING 分支}
    CHECK_CURRENT_MONKEY_Branch -->|不在圈内| STATE_2[STATE_2：移动后状态断言]
    
    %% PROCESS_COUNTING分支处理
    PROCESS_COUNTING_Branch -->|count==m| STATE_3[STATE_3：淘汰后的状态断言]
    PROCESS_COUNTING_Branch -->|count<m| STATE_1[STATE_1：报数处理后的状态断言]
    
    %% 报数未到m的处理流程
    STATE_1 -->|MOVE_TO_NEXT_MONKEY| STATE_2
    
    %% 移动到下一个猴子后循环
    STATE_2 -->|CHECK_REMAINING| CHECK_REMAINING_Branch
    
    %% 淘汰猴子后的流程
    STATE_3 -->|ELIMINATE_MONKEY| CHECK_REMAINING_Branch
    
    %% 最终状态（流程图终点）
    %% 注意：RETURN_RESULT动作标签不在流程图中体现